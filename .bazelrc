## BUILD OPTIONS


# WINDOWS C++ OPTIONS
# Rquires the installation of LLVM: https://releases.llvm.org/download.html
startup --output_user_root=C:/tmp
startup --windows_enable_symlinks
build --enable_runfiles
build --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl
build --extra_execution_platforms=//:x64_windows-clang-cl

# c-opts
build --client_env=CC=gcc
build --cxxopt='-std=c++17'
build --cxxopt='-fno-exceptions'

test --cxxopt='-DLOG_LEVEL=4'

build:debug -c dbg
build:debug --cxxopt=-DDEBUG
build:debug --cxxopt='-DLOG_LEVEL=4'

build:release -c opt
build:release --cxxopt='-DLOG_LEVEL=3'

build:race -c dbg
build:race --cxxopt=-DDEBUG
build:race --cxxopt='-DLOG_LEVEL=4'
build:race --cxxopt='-fsanitize=thread'
build:race --linkopt='-ltsan'

## TEST OPTIONS

# Verbose test output 
test --test_output=all